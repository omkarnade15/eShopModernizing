<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>eShopWinForms</RootNamespace>
    <AssemblyName>eShopWinForms</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude UWP helpers that are not part of the WinForms project -->
    <Compile Remove="Helpers\SettingsStorageExtensions.cs" />
    <Compile Remove="Helpers\NotificationsHelper.cs" />
    <Compile Remove="Helpers\UploadImageHelper.cs" />
    <Compile Remove="Helpers\DependencyObjectExtensions.cs" />
    <Compile Remove="Helpers\Json.cs" />
    <Compile Remove="Helpers\ResourceExtensions.cs" />
    <Compile Remove="Helpers\Singleton.cs" />
  </ItemGroup>
</Project>
